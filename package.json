{
  "name": "shopkart-mern-project",
  "version": "1.0.0",
  "description": "ShopKart Full Stack E-Commerce Platform (Labs 01 & 02)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "mern",
    "shopkart",
    "authentication",
    "jwt",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
