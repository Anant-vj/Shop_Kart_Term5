          }
        }
      ]
    },
    {
      "name": "2. Products Catalog & Discovery",
      "item": [
        {
          "name": "2.1 Create Product (Task 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": 2999,\n  \"category\": \"Electronics\",\n  \"image\": \"https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=800\",\n  \"stock\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "2.2 Create Product (Failure - Missing Field)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Incomplete Product\",\n  \"price\": 1999\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "2.3 Create Product (Failure - Invalid Price)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Free Product\",\n  \"description\": \"Test\",\n  \"price\": 0,\n  \"category\": \"Electronics\",\n  \"image\": \"https://example.com/img.jpg\",\n  \"stock\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "2.4 Get All Products (Task 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "2.5 Search Products by Name (Task 5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?search=keyboard",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "search", "value": "keyboard" }]
            }
          }
        },
        {
          "name": "2.6 Filter Products by Category (Task 5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?category=Electronics",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "category", "value": "Electronics" }]
            }
          }
        },
        {
          "name": "2.7 Search and Category Combined (Task 5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?search=keyboard&category=Electronics",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "keyboard" },
                { "key": "category", "value": "Electronics" }
              ]
            }
          }
        },
        {
          "name": "2.8 Sort Products by Price Ascending (Bonus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?sort=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "sort", "value": "price_asc" }]
            }
          }
        },
        {
          "name": "2.9 Sort Products by Price Descending (Bonus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?sort=price_desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "sort", "value": "price_desc" }]
            }
          }
        },
        {
          "name": "2.10 Get Single Product by ID (Task 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "2.11 Get Single Product (Failure - Invalid ID Format)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/invalid-id-123",
              "host": ["{{baseUrl}}"],
              "path": ["products", "invalid-id-123"]
            }
          }
        },
